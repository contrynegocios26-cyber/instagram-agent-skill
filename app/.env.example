# Copie para .env e preencha. Nunca envie o .env para o GitHub.

# Endereço do atendimento. Crie antes, no DNS, um registro A deste nome
# apontando para o IP da VPS.
DOMINIO=atendimento.suaagencia.com.br
URL_PUBLICA=https://atendimento.suaagencia.com.br

# Chave da API da Anthropic (crie em platform.claude.com, em API keys).
ANTHROPIC_API_KEY=

# Senhas do painel: uma para a equipe da marina, outra para a agência.
PAINEL_SENHA=
ADMIN_SENHA=

# ---------- opcionais ----------
# Modelo de IA. O padrão é o Claude Opus 5.5. Trocar muda custo e qualidade.
# IA_MODELO=claude-opus-5-5
# Esforço de raciocínio: low, medium, high. Em branco usa o padrão do modelo.
# IA_ESFORCO=
# Quanto tempo o prompt fica em cache: 1h (padrão) ou 5m.
# IA_CACHE_TTL=1h
# Teto de chamadas ao modelo por dia. Acima disso as mensagens vão para a equipe.
# IA_LIMITE_DIARIO=1500
# Começar com a marina fictícia de exemplo, para demonstração.
# SEMENTE=exemplo
# Rodar sem IA (roteiro simples, sem custo), para demonstração.
# IA_FAKE=1
