# Copie para .env e preencha. NUNCA suba o .env para o GitHub.
WA_TOKEN=            # token permanente do usuário do sistema (Meta Business > Usuários do sistema)
WA_PHONE_ID=         # "Identificação do número de telefone" no painel do WhatsApp da Meta
WA_VERIFY_TOKEN=     # uma senha qualquer que você inventa e repete no painel da Meta
WA_APP_SECRET=       # Chave secreta do aplicativo (Configurações do app > Básico)
VENDEDOR_WHATSAPP=   # seu número com DDI e DDD, só dígitos: 5544999998888
VENDEDOR_NOME=       # seu primeiro nome, aparece nas mensagens
